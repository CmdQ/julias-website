---
import '../styles/global.css';

interface AlternateLinks {
	en?: string;
	de?: string;
}

interface Props {
	lang: 'en' | 'de';
	title: string;
	description?: string;
	alternates?: AlternateLinks;
}

const siteName = 'Julia Salomon';
const { lang, title, description, alternates = {} }: Props = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const subtitles = {
	en: 'Trainer for Positive Futures\nand Active Hope',
	de: 'Trainerin für positive Zukunftsvisionen\nund aktive Hoffnung',
} as const;

const localeNav = {
	en: [
		{ href: `${base}/en/`, label: 'Home' },
		{ href: `${base}/en/about/`, label: 'About me' },
		{ href: `${base}/en/zukunft/`, label: 'Future Project' },
		{ href: `${base}/en/training/`, label: 'Communication' },
		{ href: `${base}/en/creative/`, label: 'Creative' },
		{ href: `${base}/en/contact/`, label: 'Contact' },
	],
	de: [
		{ href: `${base}/de/`, label: 'Home' },
		{ href: `${base}/de/about/`, label: 'Über mich' },
		{ href: `${base}/de/zukunft/`, label: 'Projekt Zukunft' },
		{ href: `${base}/de/training/`, label: 'Kommunikation' },
		{ href: `${base}/de/creative/`, label: 'Kreativ' },
		{ href: `${base}/de/contact/`, label: 'Kontakt' },
	],
} as const;

const navItems = localeNav[lang];
const otherLocale = lang === 'en' ? 'de' : 'en';
const switchHref = alternates[otherLocale] ?? `${base}/${otherLocale}/`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
const currentPath = Astro.url.pathname;
const subtitle = subtitles[lang];

const hreflangAlternates = {
	en: alternates.en ?? `${base}/en/`,
	de: alternates.de ?? `${base}/de/`,
};
---
<!DOCTYPE html>
<html lang={lang} class="min-h-full">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		{canonical && <link rel="canonical" href={canonical} />}
		{description && <meta name="description" content={description} />}
		{Object.entries(hreflangAlternates).map(([locale, href]) => (
			<link rel="alternate" hreflang={locale} href={href} />
		))}
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
	</head>
	<body class="min-h-screen" style="background-color: rgb(10, 24, 34);">
		<div class="mx-auto max-w-5xl" style="background-color: var(--color-bg-cream);">

	<!-- Hero Image -->
	<div class="relative w-full overflow-hidden">
		<img
			src={`${base}/images/hero.jpg`}
			alt="Julia Salomon"
			class="w-full h-auto"
		/>
	</div>

	<!-- Navigation Wrapper -->
	<div class="contents sm:sticky sm:top-0 sm:z-40 sm:flex sm:w-full sm:flex-row sm:items-center sm:justify-between sm:px-4 sm:py-3 lg:px-6" style="background-color: var(--color-highlight);">

		<!-- Name Section -->
		<div class="w-full px-4 py-4 sm:w-auto sm:p-0" style="background-color: var(--color-highlight);">
			<h1 class="m-0 text-3xl sm:text-[2rem] font-black drop-shadow-sm" style="color: var(--color-text-dark);">Julia Salomon</h1>
			<p class="mt-1 text-base sm:text-[1.1rem] font-semibold leading-snug whitespace-pre-line" style="color: var(--color-text-dark); opacity: 0.8;">{subtitle}</p>
		</div>

		<!-- Nav Section -->
		<nav
			aria-label={lang === 'en' ? 'Primary' : 'Hauptnavigation'}
			class="sticky top-0 z-40 grid w-full grid-cols-3 gap-1 px-4 py-2 shadow-md sm:static sm:w-auto sm:gap-1.5 sm:p-0 sm:shadow-none"
			style="background-color: var(--color-highlight);"
		>
			{navItems.map((item) => {
				const isActive = currentPath === item.href || currentPath === item.href.replace(/\/$/, '');
				return (
				<a
					class="rounded-xl px-3 py-2 text-center text-sm font-bold transition-colors border"
					style={isActive
						? "color: var(--color-text-dark); border-color: var(--color-text-dark); background-color: color-mix(in srgb, var(--color-white) 70%, transparent);"
						: "color: var(--color-text-dark); border-color: color-mix(in srgb, var(--color-text-dark) 20%, transparent); background-color: color-mix(in srgb, var(--color-white) 30%, transparent);"}
					href={item.href}
					aria-current={isActive ? 'page' : undefined}
				>
					{item.label}
				</a>
			)})}
		</nav>
	</div>

	<main id="main-content" class="w-full px-6 py-12 sm:px-12">
		<slot />
	</main>

	<footer style="background-color: var(--color-bg-cream);">
		<div class="flex w-full flex-col gap-4 px-6 py-8 sm:flex-row sm:items-center sm:justify-between">
			<p class="m-0 text-sm" style="color: var(--color-text-dark); opacity: 0.7;">© {new Date().getFullYear()} Julia Salomon</p>
			<div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
				<a class="text-sm font-semibold hover:underline" style="color: var(--color-text-dark);" href={`${base}/${lang}/privacy/`}>
					{lang === 'en' ? 'Privacy Notice' : 'Datenschutz'}
				</a>
				<a class="inline-flex items-center gap-2 text-sm font-semibold" style="color: var(--color-text-dark);" href={switchHref}>
					<span aria-hidden="true">🌐</span>
					{lang === 'en' ? 'Deutsch' : 'English'}
				</a>
			</div>
		</div>
	</footer>
		</div>
	</body>
</html>
